<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 8 launchers have no adaptive icons: a round badge with the same foreground. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#FFA7B9CC" android:endColor="#FF566B83" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_fg_cloudy" />
</layer-list>
