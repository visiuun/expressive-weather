<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 8 launchers have no adaptive icons: a round badge with the same foreground. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground_light" />
</layer-list>
