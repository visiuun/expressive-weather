    <!-- "How it works" explanations. Times like %1$s are clock times. -->
    <string name="al_how_warnings">Etwa alle 30 Minuten prüft die App beim nationalen Wetterdienst die Warnungen für deinen Standort. Du wirst einmal pro Warnung benachrichtigt und erneut, wenn sie hochgestuft wird. Warnungen der Stufen Orange und Rot kommen auch während der Ruhezeiten durch.</string>
    <string name="al_how_warnings_saved">Etwa alle 30 Minuten prüft die App beim nationalen Wetterdienst die Warnungen für deinen Standort und deine gespeicherten Orte. Du wirst einmal pro Warnung benachrichtigt und erneut, wenn sie hochgestuft wird. Warnungen der Stufen Orange und Rot kommen auch während der Ruhezeiten durch.</string>
    <!-- What the nowcast watches for; used as %2$s in al_how_nowcast -->
    <string name="al_how_nowcast_rain">Regen</string>
    <string name="al_how_nowcast_rain_snow">Regen oder Schnee</string>
    <string name="al_how_nowcast_moderate_rain">mäßiger Regen</string>
    <string name="al_how_nowcast_moderate_rain_snow">mäßiger Regen oder Schnee</string>
    <string name="al_how_nowcast_heavy_rain">starker Regen</string>
    <string name="al_how_nowcast_heavy_rain_snow">starker Regen oder Schnee</string>
    <!-- %1$d = minutes, %2$s = what is watched (e.g. "heavy rain or snow") -->
    <plurals name="al_how_nowcast">
        <item quantity="one">Alle 15 Minuten prüft die App die 15-Minuten-Niederschlagsprognose. Wird innerhalb von %1$d Minute %2$s erwartet, bekommst du einen Live-Countdown, der sich bis zum Beginn aktualisiert und dir dann sagt, wann es voraussichtlich aufhört. Unter Android 16 erscheint er als Live-Update-Chip in der Statusleiste.</item>
        <item quantity="other">Alle 15 Minuten prüft die App die 15-Minuten-Niederschlagsprognose. Wird innerhalb von %1$d Minuten %2$s erwartet, bekommst du einen Live-Countdown, der sich bis zum Beginn aktualisiert und dir dann sagt, wann es voraussichtlich aufhört. Unter Android 16 erscheint er als Live-Update-Chip in der Statusleiste.</item>
    </plurals>
    <!-- %1$d = hours, %2$s = start time, %3$s = end time, %4$d = percent -->
    <plurals name="al_how_rain_all_day">
        <item quantity="one">Zwischen %2$s und %3$s schaut die App etwa alle 15 Minuten %1$d Stunde voraus. Erreicht die Regenwahrscheinlichkeit %4$d %%, bekommst du einen Hinweis – höchstens einmal alle 3 Stunden.</item>
        <item quantity="other">Zwischen %2$s und %3$s schaut die App etwa alle 15 Minuten %1$d Stunden voraus. Erreicht die Regenwahrscheinlichkeit %4$d %%, bekommst du einen Hinweis – höchstens einmal alle 3 Stunden.</item>
    </plurals>
    <!-- %1$d = hours, %2$s = time, %3$d = percent -->
    <plurals name="al_how_rain_once">
        <item quantity="one">Um %2$s prüft die App die nächste Stunde. Erreicht die Regenwahrscheinlichkeit %3$d %%, bekommst du eine Benachrichtigung mit der erwarteten Uhrzeit.</item>
        <item quantity="other">Um %2$s prüft die App die nächsten %1$d Stunden. Erreicht die Regenwahrscheinlichkeit %3$d %%, bekommst du eine Benachrichtigung mit der erwarteten Uhrzeit.</item>
    </plurals>
    <!-- %1$d = hours, %2$s = wind speed -->
    <plurals name="al_how_storm">
        <item quantity="one">Alle 30 Minuten schaut die App %1$d Stunde voraus, ob Böen ab %2$s oder Gewitter drohen. Höchstens ein Alarm alle 8 Stunden.</item>
        <item quantity="other">Alle 30 Minuten schaut die App %1$d Stunden voraus, ob Böen ab %2$s oder Gewitter drohen. Höchstens ein Alarm alle 8 Stunden.</item>
    </plurals>
    <string name="al_how_today">Um %1$s bekommst du eine kurze Übersicht: Wetterlage, Höchst- und Tiefstwert, wann Regen wahrscheinlich ist, auffälliger Wind oder UV und der Vergleich zu gestern.</string>
    <string name="al_how_tomorrow">Um %1$s schaut sich die App die Vorhersage für morgen an und schickt dir eine kurze, gut lesbare Zusammenfassung, was dich erwartet und wie es im Vergleich zu heute wird.</string>
    <string name="al_how_wardrobe">Um %1$s (oder am Vorabend, wenn nach 15:00 eingestellt) schaut sich die App die Stunden an, in denen du unterwegs bist, berücksichtigt dein Kälteempfinden und deinen Arbeitsweg und schlägt vor, was du anziehen und mitnehmen solltest.</string>
    <string name="al_how_wardrobe_work">Für 09:00–17:00 wird die Vorhersage für deinen Arbeitsort verwendet.</string>
    <!-- %1$s = time, %2$s = temperature -->
    <string name="al_how_frost">Um %1$s prüft die App die tiefste Temperatur der Nacht bis morgen 10:00 Uhr. Erreicht sie %2$s oder weniger, bekommst du eine Frostwarnung.</string>
    <!-- %1$s = time, %2$d = UV index -->
    <string name="al_how_uv">Um %1$s prüft die App die heutige UV-Vorhersage. Liegt sie über %2$d, erfährst du, wann der Höchstwert erreicht wird und wann du deine Haut schützen solltest.</string>
    <!-- %1$d = hours, %2$s = temperature, %3$s = cooling level in lower case -->
    <plurals name="al_how_heat">
        <item quantity="one">Alle 30 Minuten prüft die App die Feuchtkugeltemperatur jetzt und für die nächste Stunde. Erreicht sie %2$s (%3$s), wirst du sofort gewarnt – am selben Tag nur dann erneut, wenn es schlimmer wird. Diese Alarme sind auch während der Ruhezeiten hörbar.</item>
        <item quantity="other">Alle 30 Minuten prüft die App die Feuchtkugeltemperatur jetzt und für die nächsten %1$d Stunden. Erreicht sie %2$s (%3$s), wirst du sofort gewarnt – am selben Tag nur dann erneut, wenn es schlimmer wird. Diese Alarme sind auch während der Ruhezeiten hörbar.</item>
    </plurals>
    <!-- %1$s = time, %2$s = air quality level in lower case -->
    <string name="al_how_air">Um %1$s prüft die App den Europäischen Luftqualitätsindex für die nächsten 18 Stunden. Erreicht er die Stufe „%2$s“ oder schlechter, bekommst du einen Alarm.</string>
    <!-- %1$s = time, %2$s = list of allergens -->
    <string name="al_how_pollen">Um %1$s prüft die App die Pollenvorhersage für %2$s.</string>
    <string name="al_how_pollen_fallback">deine Allergene</string>
