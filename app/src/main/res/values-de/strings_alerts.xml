    <!-- ============================================================ Alert types: title, one-line subtitle, long description -->
    <string name="al_type_warnings_title">Unwetterwarnungen</string>
    <string name="al_type_warnings_subtitle">Amtliche Warnungen der Stufen Gelb, Orange &amp; Rot</string>
    <string name="al_type_warnings_desc">Werde benachrichtigt, sobald ein nationaler Wetterdienst eine Warnung für deinen Standort herausgibt oder hochstuft. Abgedeckt sind die USA (NWS), Kanada (ECCC), Deutschland (DWD) und 36 weitere europäische Länder (MeteoAlarm).</string>

    <string name="al_type_nowcast_title">Regen &amp; Schnee in Kürze</string>
    <string name="al_type_nowcast_subtitle">Minuten bevor Regen oder Schnee einsetzt</string>
    <string name="al_type_nowcast_desc">Ein kurzer Hinweis, kurz bevor Regen oder Schnee kommt, mit einem Live-Countdown, der sich bis zum Beginn aktualisiert und dir dann sagt, wann es wieder aufhört. Nutzt die 15-Minuten-Kurzfristprognose, die in Europa und Nordamerika auf hochaufgelösten Radardaten basiert.</string>

    <string name="al_type_rain_title">Regenalarm</string>
    <string name="al_type_rain_subtitle">Regen in den nächsten Stunden</string>
    <string name="al_type_rain_desc">Schirm nicht vergessen: Werde benachrichtigt, wenn in den nächsten Stunden Regen wahrscheinlich ist. Einmal zu einer festen Uhrzeit prüfen oder den ganzen Tag über in den Stunden, die du auswählst.</string>

    <string name="al_type_storm_title">Wind- &amp; Sturmalarm</string>
    <string name="al_type_storm_subtitle">Starke Böen oder Gewitter im Anmarsch</string>
    <string name="al_type_storm_desc">Werde benachrichtigt, wenn in den nächsten 12 Stunden Böen über deinem Grenzwert oder Gewitter vorhergesagt werden – auch wenn keine amtliche Warnung vorliegt.</string>

    <string name="al_type_today_title">Morgenübersicht</string>
    <string name="al_type_today_subtitle">Das Wetter deines Tages auf einen Blick</string>
    <string name="al_type_today_desc">Jeden Morgen eine kurze Zusammenfassung: Wetterlage, Höchst- und Tiefstwert, wann es regnet, Wind und alles Auffällige – im Vergleich zu gestern.</string>

    <string name="al_type_tomorrow_title">Wetter für morgen</string>
    <string name="al_type_tomorrow_subtitle">Abendliche Vorschau auf morgen</string>
    <string name="al_type_tomorrow_desc">Jeden Abend eine gut lesbare Zusammenfassung für morgen, damit du vorausplanen kannst: der Vergleich zu heute, Regen, Wind und Schnee.</string>

    <string name="al_type_wardrobe_title">Was anziehen?</string>
    <string name="al_type_wardrobe_subtitle">Tipps zu Kleidung und Mitnehmen</string>
    <string name="al_type_wardrobe_desc">Tägliche Tipps, was du anziehen und mitnehmen solltest – abgestimmt auf deinen Arbeitsweg, dein Kälteempfinden und das Wetter zu Hause und bei der Arbeit.</string>

    <string name="al_type_frost_title">Frostalarm</string>
    <string name="al_type_frost_subtitle">Nachttemperaturen um oder unter dem Gefrierpunkt</string>
    <string name="al_type_frost_desc">Werde am Vorabend benachrichtigt, wenn die Temperatur nachts voraussichtlich auf deinen Grenzwert fällt. So kannst du Pflanzen, Leitungen und Haustiere schützen und Zeit zum Enteisen des Autos einplanen.</string>

    <string name="al_type_uv_title">UV-Alarm</string>
    <string name="al_type_uv_subtitle">UV-Index über deinem Grenzwert</string>
    <string name="al_type_uv_desc">Jeden Morgen eine Erinnerung, deine Haut zu schützen, wenn der UV-Index deinen Grenzwert überschreitet – mit den Stunden, in denen Schutz nötig ist.</string>

    <string name="al_type_heat_title">Gefährliche Feuchtkugeltemperatur</string>
    <string name="al_type_heat_subtitle">Wenn Hitze und Luftfeuchtigkeit gefährlich werden</string>
    <string name="al_type_heat_desc">Die Feuchtkugeltemperatur fasst Hitze und Luftfeuchtigkeit dazu zusammen, wie gut Schweiß dich noch kühlen kann. Du wirst gewarnt, sobald sie voraussichtlich einen gefährlichen Wert erreicht, damit du Anstrengung vermeiden, Schatten oder kühle Räume aufsuchen und genug trinken kannst.</string>

    <string name="al_type_air_title">Luftqualitätsalarm</string>
    <string name="al_type_air_subtitle">Luftqualität auf oder unter deinem Grenzwert</string>
    <string name="al_type_air_desc">Zu deiner Alarmzeit wird die Vorhersage des Europäischen Luftqualitätsindex geprüft. Erreicht sie deinen Grenzwert oder ist schlechter, bekommst du einen Hinweis, Anstrengung im Freien zu reduzieren.</string>

    <string name="al_type_pollen_title">Pollenalarm</string>
    <string name="al_type_pollen_subtitle">Erhöhter Pollenflug für deine Allergien</string>
    <string name="al_type_pollen_desc">Prüft jeden Morgen die Pollenvorhersage für die Allergene, die du auswählst, und gibt dir Bescheid, wenn die Belastung deine Empfindlichkeit übersteigt. Pollenvorhersagen gibt es für Europa.</string>

    <string name="al_type_tablet_title">Erinnerung an Heuschnupfentablette</string>
    <string name="al_type_tablet_subtitle">Tägliche Erinnerung an deine Tablette</string>
    <string name="al_type_tablet_desc">Eine einfache tägliche Erinnerung zur gewählten Uhrzeit. Optional nur an Tagen, an denen der Grenzwert deines Pollenalarms erreicht wird.</string>

    <string name="al_type_pressure_title">Luftdruckabfall-Alarm</string>
    <string name="al_type_pressure_subtitle">Schneller Abfall des Luftdrucks</string>
    <string name="al_type_pressure_desc">Ein schneller Druckabfall kündigt oft stürmisches Wetter an und kann bei manchen Menschen Kopfschmerzen oder Migräne auslösen. Werde benachrichtigt, wenn der Luftdruck innerhalb von 3 Stunden voraussichtlich stark fällt.</string>

    <string name="al_type_friends_title">Familie &amp; Freunde</string>
    <string name="al_type_friends_subtitle">Warnungen dort, wo deine Liebsten sind</string>
    <string name="al_type_friends_desc">Werde benachrichtigt, wenn für den Ort einer Person aus deiner Liste „Familie &amp; Freunde“ eine amtliche Warnung herausgegeben wird.</string>

    <string name="al_type_ongoing_title">Wetter in der Statusleiste</string>
    <string name="al_type_ongoing_subtitle">Aktuelle Temperatur immer im Blick</string>
    <string name="al_type_ongoing_desc">Zeigt die aktuelle Temperatur in der Statusleiste und eine lautlose Benachrichtigung mit der heutigen Vorhersage, die im Hintergrund aktualisiert wird.</string>

