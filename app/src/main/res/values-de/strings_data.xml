    <string name="d_press_falling">Fallend</string>
    <string name="d_press_falling_text">Fallender Luftdruck kündigt oft Wolken, Regen und Wind an.</string>
    <string name="d_press_rising_fast">Steigt schnell</string>
    <string name="d_press_rising_fast_text">Der Luftdruck steigt schnell; das Wetter klart auf, kann aber windig sein.</string>
    <string name="d_press_rising">Steigend</string>
    <string name="d_press_rising_text">Steigender Luftdruck bedeutet meist beständigeres, trockeneres Wetter.</string>
    <string name="d_press_steady">Gleichbleibend</string>
    <string name="d_press_steady_text">Allein vom Luftdruck her keine große Änderung.</string>
    <string name="d_press_headache_sharp">Kopfschmerzrisiko: Ein starker Druckabfall kann bei wetterfühligen Menschen Kopfschmerzen und Migräne auslösen.</string>
