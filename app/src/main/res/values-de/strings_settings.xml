    <!-- Settings > Data & accuracy -->
    <string name="s_data_title">Daten</string>
    <string name="s_data_intro">Woher deine Vorhersage kommt</string>
    <string name="s_data_intro_body">Expressive Weather nutzt kostenlose, offene Daten nationaler Wetterdienste. Kein Konto, kein API-Schlüssel, kein Tracking: Nur der Ort, den du ansiehst, wird an die unten stehenden Dienste übertragen.</string>
    <string name="s_data_group_model">Vorhersagemodell</string>
    <string name="s_data_about_models">Über die Modelle</string>
    <string name="s_data_about_models_body">„Automatisch“ wählt das schärfste Modell für deine Region – zum Beispiel ICON-D2 in Deutschland, AROME in Frankreich, HRRR in den USA oder Harmonie in den Niederlanden – und ergänzt spätere Tage mit ECMWF und GFS. Ein Modell selbst auszuwählen ist ideal zum Vergleichen; fehlen ihm Daten (UV, Sichtweite, Regenwahrscheinlichkeit oder spätere Tage), füllt die automatische Vorhersage die Lücke.</string>
    <string name="s_data_group_accuracy">Genauigkeit</string>
    <string name="s_data_local_correction">Lokale Korrektur</string>
    <!-- %1$d = search radius in km -->
    <string name="s_data_local_correction_sub">Vergleicht die Vorhersage mit der nächstgelegenen Flughafen-Wetterstation (METAR, im Umkreis von %1$d km) und passt die nächsten 6 Stunden an die tatsächlichen Messwerte an. Datenschutz: Nur ein grober Bereich um dich herum (ein gerundetes Feld von ca. 70 km) wird an aviationweather.gov der NOAA gesendet – nie dein genauer Standort.</string>
    <string name="s_data_show_source">Datenquelle anzeigen</string>
    <string name="s_data_show_source_sub">Zeigt unten in der Vorhersage, welches Modell und welche Station verwendet wurden.</string>
    <string name="s_data_group_sources">Datenquellen</string>
    <!-- Data sources list: what each provider is used for, and its licence -->
