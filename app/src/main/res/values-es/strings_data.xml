    <!-- Cooling comfort (how well sweat cools you, from wet-bulb temperature): level names and explanations -->
    <string name="d_cool_normal">Normal</string>
    <string name="d_cool_normal_text">No hace suficiente calor como para que la refrigeración importe.</string>
    <string name="d_cool_good">Buena</string>
    <string name="d_cool_good_text">El sudor se evapora con facilidad y el cuerpo se refresca bien.</string>
    <string name="d_cool_reduced">Reducida</string>
    <string name="d_cool_reduced_text">El sudor te refresca menos. Tómatelo con calma al hacer ejercicio y bebe agua.</string>
    <string name="d_cool_difficult">Difícil</string>
    <string name="d_cool_difficult_text">Cuesta refrescarse. Evita la actividad intensa en las horas de más calor y busca sombra y ventiladores.</string>
    <string name="d_cool_very_difficult">Muy difícil</string>
    <string name="d_cool_very_difficult_text">Es probable el estrés térmico incluso en reposo para las personas vulnerables. Quédate en lugares frescos.</string>
    <string name="d_cool_critical">Crítica</string>
    <string name="d_cool_critical_text">Cerca del límite de refrigeración humana. Quédate en un lugar con aire acondicionado y pregunta cómo están los demás.</string>

