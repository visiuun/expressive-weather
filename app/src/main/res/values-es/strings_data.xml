    <!-- Explanations shown under the cooling comfort and fire weather details -->
    <string name="d_cool_explainer">El cuerpo se refresca sudando. La temperatura de bulbo húmedo combina calor y humedad para mostrar lo bien que se evapora ese sudor: cuanto más se acerca a la temperatura de la piel (~35 °C), menos te refrescas. Por encima de ~31 °C, incluso las personas sanas tienen dificultades para mantenerse frescas durante mucho tiempo.</string>
    <string name="d_fire_explainer">El índice meteorológico de incendios de Fosberg estima la rapidez con la que podría propagarse un incendio solo a partir del tiempo: el calor y el aire seco resecan combustibles finos como la hierba, y el viento aviva las llamas. No tiene en cuenta lo seco que ha estado el suelo en las últimas semanas, así que sigue siempre los niveles de riesgo y las prohibiciones oficiales.</string>

    <!-- Pressure trend (change over the last 3 hours): label and explanation -->
    <string name="d_press_dropping_fast">Bajando rápido</string>
    <string name="d_press_dropping_fast_text">La presión baja rápidamente: señal de que se acerca una tormenta o viento fuerte.</string>
    <string name="d_press_falling">Bajando</string>
    <string name="d_press_falling_text">Una bajada de presión suele preceder a nubes, lluvia y viento.</string>
    <string name="d_press_rising_fast">Subiendo rápido</string>
    <string name="d_press_rising_fast_text">La presión sube rápidamente; el tiempo mejora, aunque puede haber viento.</string>
    <string name="d_press_rising">Subiendo</string>
    <string name="d_press_rising_text">Una subida de presión suele indicar tiempo más estable y seco.</string>
    <string name="d_press_steady">Estable</string>
    <string name="d_press_steady_text">Sin grandes cambios debidos solo a la presión.</string>
    <string name="d_press_headache_sharp">Riesgo de dolor de cabeza: las bajadas bruscas de presión pueden provocar dolores de cabeza y migrañas en personas sensibles.</string>
    <!-- %1$d = pressure drop in hPa (5 or more) -->
    <string name="d_press_headache_fall">La presión bajará %1$d hPa durante el próximo día, algo que algunas personas notan como dolor de cabeza o de articulaciones.</string>

    <!-- Air pollutants: what each one is (chemical symbols like PM2.5, NO₂ stay as they are) -->
