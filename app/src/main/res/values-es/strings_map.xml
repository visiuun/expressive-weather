    <string name="map_error_storms">No se pudieron cargar las tormentas</string>
    <string name="map_error_generic">No se pudieron cargar los datos del mapa</string>
    <string name="map_retry">Reintentar</string>

    <!-- Map timeline labels, relative to now. %1$s is a sign character (+ or −), %2$d/%3$d are numbers.
         Keep these very short (they sit under a slider). -->
    <string name="map_now">Ahora</string>
    <string name="map_rel_minutes">%1$s%2$d min</string>
    <string name="map_rel_hours">%1$s%2$d h</string>
    <string name="map_rel_hours_minutes">%1$s%2$d h %3$d min</string>
    <!-- Forecast hour: %1$s = day name (e.g. Today, Tue), %2$s = time of day -->
    <string name="map_day_time">%1$s %2$s</string>
    <!-- Radar timeline: %1$s = time of a nowcast (future) radar frame -->
    <string name="map_radar_forecast_time">Previsión · %1$s</string>

    <!-- Map top panel subtitle. %1$s = relative time (e.g. Now, −30 min), %2$s = clock time. RainViewer / Open-Meteo are brand names. -->
    <string name="map_sub_radar">%1$s · %2$s · RainViewer</string>
    <string name="map_sub_radar_empty">No hay imágenes de radar disponibles ahora</string>
    <!-- %1$s = relative hour (e.g. +3h), %2$s = day and time -->
    <string name="map_sub_model">%1$s · %2$s · Open-Meteo</string>
    <plurals name="map_sub_storms_active">
        <item quantity="one">%1$d activa · NOAA NHC</item>
        <item quantity="many">%1$d activas · NOAA NHC</item>
        <item quantity="other">%1$d activas · NOAA NHC</item>
    </plurals>
    <string name="map_loading">Cargando…</string>
    <string name="map_no_storms">No hay tormentas tropicales activas ahora</string>

    <!-- Map legend under the radar layer: precipitation intensity (light rain, moderate rain, heavy rain) -->
    <string name="map_legend_radar_light">Débil</string>
    <string name="map_legend_radar_moderate">Moderada</string>
    <string name="map_legend_radar_heavy">Fuerte</string>
    <!-- Map legend under the cloud cover layer: clear sky, partly cloudy, overcast -->
    <string name="map_legend_cloud_clear">Despejado</string>
    <string name="map_legend_cloud_partly">Parcial</string>
    <string name="map_legend_cloud_overcast">Cubierto</string>
