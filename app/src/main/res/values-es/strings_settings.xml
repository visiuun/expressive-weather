    <!-- Settings > Data & accuracy -->
    <string name="s_data_title">Datos</string>
    <string name="s_data_intro">De dónde viene tu previsión</string>
    <string name="s_data_intro_body">Expressive Weather usa datos abiertos y gratuitos de servicios meteorológicos nacionales. Sin cuenta, sin clave de API, sin rastreo: solo se envía a los servicios de abajo la ubicación que estás viendo.</string>
    <string name="s_data_group_model">Modelo de previsión</string>
    <string name="s_data_about_models">Acerca de los modelos</string>
    <string name="s_data_about_models_body">Auto elige el modelo más preciso para tu zona —por ejemplo, ICON-D2 en Alemania, AROME en Francia, HRRR en EE. UU. o Harmonie en los Países Bajos— y lo combina con ECMWF y GFS para los días siguientes. Elegir un modelo tú mismo es ideal para comparar; cuando no tiene datos de algo (UV, visibilidad, probabilidad de lluvia o días posteriores), la previsión Auto completa los huecos.</string>
    <string name="s_data_group_accuracy">Precisión</string>
    <string name="s_data_local_correction">Corrección local</string>
    <!-- %1$d = search radius in km -->
    <string name="s_data_local_correction_sub">Compara la previsión con la estación meteorológica del aeropuerto más cercano (METAR, a menos de %1$d km) y ajusta las próximas 6 horas hacia lo que realmente se mide. Privacidad: solo se envía una zona aproximada a tu alrededor (un recuadro de ~70 km, redondeado) a aviationweather.gov de la NOAA, nunca tu ubicación exacta.</string>
    <string name="s_data_show_source">Mostrar fuente de datos</string>
    <string name="s_data_show_source_sub">Muestra al final de la previsión qué modelo y estación se han usado.</string>
    <string name="s_data_group_sources">Fuentes de datos</string>
    <!-- Data sources list: what each provider is used for, and its licence -->
    <string name="s_src_openmeteo_use">Previsiones, calidad del aire (Copernicus CAMS), datos marinos y búsqueda de lugares</string>
    <string name="s_src_national">Servicios meteorológicos nacionales</string>
    <string name="s_src_national_use">Modelos que usa Auto: DWD, NOAA, ECMWF, Météo-France, Met Office, KNMI, DMI, MET Norway, MeteoSwiss, ECCC, JMA y más</string>
