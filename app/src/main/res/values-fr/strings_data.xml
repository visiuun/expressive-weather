    <string name="d_press_dropping_fast_text">La pression chute rapidement — signe d\'une tempête ou d\'un vent fort à l\'approche.</string>
    <string name="d_press_falling">En baisse</string>
    <string name="d_press_falling_text">Une baisse de pression précède souvent nuages, pluie et vent.</string>
    <string name="d_press_rising_fast">Hausse rapide</string>
    <string name="d_press_rising_fast_text">La pression monte rapidement ; le temps se dégage, mais le vent peut souffler.</string>
    <string name="d_press_rising">En hausse</string>
    <string name="d_press_rising_text">Une hausse de pression annonce généralement un temps plus stable et plus sec.</string>
    <string name="d_press_steady">Stable</string>
    <string name="d_press_steady_text">Pas de grand changement à attendre d\'après la pression seule.</string>
    <string name="d_press_headache_sharp">Risque de maux de tête : les fortes baisses de pression peuvent déclencher maux de tête et migraines chez les personnes sensibles.</string>
    <!-- %1$d = pressure drop in hPa (5 or more) -->
    <string name="d_press_headache_fall">La pression va baisser de %1$d hPa dans les prochaines 24 h, ce que certaines personnes ressentent sous forme de maux de tête ou de douleurs articulaires.</string>

