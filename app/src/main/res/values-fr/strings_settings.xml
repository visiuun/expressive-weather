    <!-- Settings > Data & accuracy -->
    <string name="s_data_title">Données</string>
    <string name="s_data_intro">D\'où viennent vos prévisions</string>
    <string name="s_data_intro_body">Expressive Weather utilise des données ouvertes et gratuites provenant des services météo nationaux. Pas de compte, pas de clé API, aucun suivi : seul le lieu que vous consultez est envoyé aux services ci-dessous.</string>
    <string name="s_data_group_model">Modèle de prévision</string>
    <string name="s_data_about_models">À propos des modèles</string>
    <string name="s_data_about_models_body">Auto choisit le modèle le plus précis pour votre région — par exemple ICON-D2 en Allemagne, AROME en France, HRRR aux États-Unis ou Harmonie aux Pays-Bas — et le combine avec ECMWF et GFS pour les jours suivants. Choisir vous-même un modèle est idéal pour comparer ; quand il manque une donnée (UV, visibilité, probabilité de pluie ou jours suivants), les prévisions Auto comblent le manque.</string>
    <string name="s_data_group_accuracy">Précision</string>
    <string name="s_data_local_correction">Correction locale</string>
    <!-- %1$d = search radius in km -->
    <string name="s_data_local_correction_sub">Compare les prévisions avec la station météo d\'aéroport la plus proche (METAR, dans un rayon de %1$d km) et ajuste les 6 prochaines heures vers les valeurs réellement mesurées. Confidentialité : seule une zone approximative autour de vous (un carré d\'environ 70 km, arrondi) est envoyée à aviationweather.gov de la NOAA — jamais votre position exacte.</string>
    <string name="s_data_show_source">Afficher la source des données</string>
    <string name="s_data_show_source_sub">Indique en bas des prévisions le modèle et la station utilisés.</string>
    <string name="s_data_group_sources">Sources des données</string>
