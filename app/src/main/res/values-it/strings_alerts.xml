    <!-- ============================================================ Alert types: title, one-line subtitle, long description -->
    <string name="al_type_warnings_title">Allerte meteo</string>
    <string name="al_type_warnings_subtitle">Allerte ufficiali gialle, arancioni e rosse</string>
    <string name="al_type_warnings_desc">Ricevi una notifica non appena un servizio meteorologico nazionale emette un\'allerta per la tua località e quando viene innalzata di livello. Copre Stati Uniti (NWS), Canada (ECCC), Germania (DWD) e altri 36 paesi europei (MeteoAlarm).</string>

    <string name="al_type_nowcast_title">Pioggia e neve imminenti</string>
    <string name="al_type_nowcast_subtitle">Pochi minuti prima che inizi a piovere o nevicare</string>
    <string name="al_type_nowcast_desc">Un avviso poco prima che arrivino pioggia o neve, con un conto alla rovescia in tempo reale che si aggiorna fino all\'inizio e ti dice quando smetterà. Usa il nowcast a 15 minuti, basato su dati radar ad alta risoluzione in Europa e Nord America.</string>

    <string name="al_type_rain_title">Avviso pioggia</string>
    <string name="al_type_rain_subtitle">Pioggia prevista nelle prossime ore</string>
    <string name="al_type_rain_desc">Prendi l\'ombrello: ricevi una notifica quando è probabile che piova nelle prossime ore. Controlla una volta a un orario fisso o per tutto il giorno nelle ore che scegli.</string>

    <string name="al_type_storm_title">Avviso vento e temporali</string>
    <string name="al_type_storm_subtitle">Forti raffiche o temporali in arrivo</string>
    <string name="al_type_storm_desc">Ricevi una notifica quando nelle prossime 12 ore sono previsti temporali o raffiche oltre il tuo limite, anche se non è stata emessa nessuna allerta ufficiale.</string>

    <string name="al_type_today_title">Riepilogo del mattino</string>
    <string name="al_type_today_subtitle">Il meteo della tua giornata in breve</string>
    <string name="al_type_today_desc">Un breve riepilogo ogni mattina: condizioni, massima e minima, orari della pioggia, vento e tutto ciò che è degno di nota, rispetto a ieri.</string>

    <string name="al_type_tomorrow_title">Meteo di domani</string>
    <string name="al_type_tomorrow_subtitle">Riepilogo serale di domani</string>
    <string name="al_type_tomorrow_desc">Ogni sera, un riepilogo chiaro di domani per organizzarti: confronto con oggi, pioggia, vento e neve.</string>

    <string name="al_type_wardrobe_title">Cosa indossare</string>
    <string name="al_type_wardrobe_subtitle">Consigli su vestiti e cosa portare</string>
    <string name="al_type_wardrobe_desc">Consigli quotidiani su cosa indossare e portare, in base ai tuoi spostamenti, a quanto soffri il freddo e al meteo a casa e al lavoro.</string>

    <string name="al_type_frost_title">Avviso gelo</string>
    <string name="al_type_frost_subtitle">Temperature notturne pari o inferiori a zero</string>
    <string name="al_type_frost_desc">Ricevi una notifica la sera prima quando si prevede che la temperatura notturna scenda alla tua soglia, così puoi proteggere piante, tubature e animali e avere il tempo di sbrinare l\'auto.</string>

    <string name="al_type_uv_title">Avviso UV</string>
    <string name="al_type_uv_subtitle">Indice UV sopra la tua soglia</string>
    <string name="al_type_uv_desc">Ogni mattina, un promemoria per proteggere la pelle quando l\'indice UV supererà la tua soglia, con le ore in cui serve protezione.</string>

    <string name="al_type_heat_title">Bulbo umido pericoloso</string>
    <string name="al_type_heat_subtitle">Quando caldo e umidità diventano pericolosi</string>
    <string name="al_type_heat_desc">La temperatura di bulbo umido combina caldo e umidità per indicare quanto il sudore riesce a rinfrescarti. Ricevi un avviso non appena si prevede che raggiunga un livello pericoloso, così puoi limitare gli sforzi, cercare ombra o aria fresca e idratarti.</string>

    <string name="al_type_air_title">Avviso qualità dell\'aria</string>
    <string name="al_type_air_subtitle">Qualità dell\'aria pari o peggiore della tua soglia</string>
    <string name="al_type_air_desc">All\'orario scelto controlla le previsioni dell\'indice europeo di qualità dell\'aria. Se raggiunge la tua soglia o peggio, riceverai un avviso per limitare gli sforzi all\'aperto.</string>

    <string name="al_type_pollen_title">Avviso pollini</string>
    <string name="al_type_pollen_subtitle">Pollini elevati per le tue allergie</string>
    <string name="al_type_pollen_desc">Ogni mattina controlla le previsioni per gli allergeni che scegli e ti avvisa quando i livelli superano la tua sensibilità. Le previsioni dei pollini coprono l\'Europa.</string>

    <string name="al_type_tablet_title">Promemoria antistaminico</string>
    <string name="al_type_tablet_subtitle">Un promemoria quotidiano per prendere la compressa</string>
    <string name="al_type_tablet_desc">Un semplice promemoria quotidiano all\'ora che scegli. Facoltativamente solo nei giorni in cui viene raggiunta la soglia del tuo avviso pollini.</string>

    <string name="al_type_pressure_title">Avviso calo di pressione</string>
    <string name="al_type_pressure_subtitle">Cali rapidi della pressione atmosferica</string>
    <string name="al_type_pressure_desc">I cali rapidi di pressione precedono spesso il maltempo e in alcune persone possono scatenare mal di testa o emicranie. Ricevi una notifica quando si prevede che la pressione scenda rapidamente in 3 ore.</string>

    <string name="al_type_friends_title">Famiglia e amici</string>
    <string name="al_type_friends_subtitle">Allerte dove si trovano i tuoi cari</string>
    <string name="al_type_friends_desc">Ricevi una notifica quando viene emessa un\'allerta ufficiale nel luogo di qualcuno della tua lista Famiglia e amici.</string>

    <string name="al_type_ongoing_title">Meteo nella barra di stato</string>
    <string name="al_type_ongoing_subtitle">Temperatura attuale sempre in vista</string>
    <string name="al_type_ongoing_desc">Mostra la temperatura attuale nella barra di stato e una notifica silenziosa con le previsioni di oggi, aggiornata in background.</string>

