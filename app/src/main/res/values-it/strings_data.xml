    <!-- Cooling comfort (how well sweat cools you, from wet-bulb temperature): level names and explanations -->
    <string name="d_cool_normal">Normale</string>
    <string name="d_cool_normal_text">Non fa abbastanza caldo perché il raffreddamento conti.</string>
    <string name="d_cool_good">Buono</string>
    <string name="d_cool_good_text">Il sudore evapora facilmente e il corpo si raffredda bene.</string>
    <string name="d_cool_reduced">Ridotto</string>
    <string name="d_cool_reduced_text">Il sudore ti rinfresca meno. Fai sport con più calma e bevi acqua.</string>
    <string name="d_cool_difficult">Difficile</string>
    <string name="d_cool_difficult_text">Raffreddarsi è difficile. Evita attività faticose nelle ore più calde, cerca ombra e ventilatori.</string>
    <string name="d_cool_very_difficult">Molto difficile</string>
    <string name="d_cool_very_difficult_text">Stress da calore probabile anche a riposo per le persone vulnerabili. Resta in luoghi freschi.</string>
    <string name="d_cool_critical">Critico</string>
    <string name="d_cool_critical_text">Vicino al limite di raffreddamento umano. Resta in ambienti climatizzati e controlla come stanno gli altri.</string>

