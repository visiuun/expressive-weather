    <string name="d_humid_comfortable_text">Piacevole, non noterai l\'umidità.</string>
    <string name="d_humid_noticeable">Percettibile</string>
    <string name="d_humid_noticeable_text">Inizi a sentire l\'umidità nell\'aria.</string>
    <string name="d_humid_sticky">Appiccicoso</string>
    <string name="d_humid_sticky_text">Aria umida; l\'attività fisica risulta più faticosa.</string>
    <string name="d_humid_muggy">Afoso</string>
    <string name="d_humid_muggy_text">Aria pesante e fastidiosa per la maggior parte delle persone.</string>
    <string name="d_humid_oppressive">Opprimente</string>
