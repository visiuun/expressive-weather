    <!-- Settings > Data & accuracy -->
    <string name="s_data_title">Dati</string>
    <string name="s_data_intro">Da dove arrivano le tue previsioni</string>
    <string name="s_data_intro_body">Expressive Weather usa dati aperti e gratuiti dei servizi meteorologici nazionali. Nessun account, nessuna chiave API, nessun tracciamento: ai servizi qui sotto viene inviata solo la località che stai visualizzando.</string>
    <string name="s_data_group_model">Modello di previsione</string>
    <string name="s_data_about_models">Informazioni sui modelli</string>
    <string name="s_data_about_models_body">Auto sceglie il modello più preciso per la tua zona (ad esempio ICON-D2 in Germania, AROME in Francia, HRRR negli USA o Harmonie nei Paesi Bassi) e integra ECMWF e GFS per i giorni successivi. Scegliere tu un modello è ottimo per fare confronti; quando non ha dati per qualcosa (UV, visibilità, probabilità di pioggia o giorni successivi), le previsioni Auto colmano la lacuna.</string>
    <string name="s_data_group_accuracy">Precisione</string>
    <string name="s_data_local_correction">Correzione locale</string>
    <!-- %1$d = search radius in km -->
    <string name="s_data_local_correction_sub">Confronta le previsioni con la stazione meteo aeroportuale più vicina (METAR, entro %1$d km) e corregge le prossime 6 ore verso i valori realmente misurati. Privacy: a aviationweather.gov della NOAA viene inviata solo un\'area approssimativa intorno a te (un riquadro di ~70 km, arrotondato), mai la tua posizione esatta.</string>
    <string name="s_data_show_source">Mostra fonte dei dati</string>
    <string name="s_data_show_source_sub">Mostra in fondo alle previsioni quale modello e quale stazione sono stati usati.</string>
    <string name="s_data_group_sources">Fonti dei dati</string>
