    <!-- "How it works" explanations. Times like %1$s are clock times. -->
    <string name="al_how_warnings">Ongeveer elke 30 minuten controleert de app de nationale weerdienst voor je locatie. Je krijgt één melding per waarschuwing, en nog een als die wordt verhoogd. Codes oranje en rood komen ook tijdens stille uren door.</string>
    <string name="al_how_warnings_saved">Ongeveer elke 30 minuten controleert de app de nationale weerdienst voor je locatie en je opgeslagen plaatsen. Je krijgt één melding per waarschuwing, en nog een als die wordt verhoogd. Codes oranje en rood komen ook tijdens stille uren door.</string>
    <!-- What the nowcast watches for; used as %2$s in al_how_nowcast -->
    <string name="al_how_nowcast_rain">regen</string>
    <string name="al_how_nowcast_rain_snow">regen of sneeuw</string>
    <string name="al_how_nowcast_moderate_rain">matige regen</string>
    <string name="al_how_nowcast_moderate_rain_snow">matige regen of sneeuw</string>
    <string name="al_how_nowcast_heavy_rain">zware regen</string>
    <string name="al_how_nowcast_heavy_rain_snow">zware regen of sneeuw</string>
    <!-- %1$d = minutes, %2$s = what is watched (e.g. "heavy rain or snow") -->
    <plurals name="al_how_nowcast">
        <item quantity="one">Elke 15 minuten controleert de app de neerslagverwachting per 15 minuten. Wordt er binnen %1$d minuut %2$s verwacht, dan krijg je een live aftelling die wordt bijgewerkt tot het begint en je daarna vertelt wanneer het zou moeten stoppen. Op Android 16 verschijnt dit als Live Update-chip in de statusbalk.</item>
        <item quantity="other">Elke 15 minuten controleert de app de neerslagverwachting per 15 minuten. Wordt er binnen %1$d minuten %2$s verwacht, dan krijg je een live aftelling die wordt bijgewerkt tot het begint en je daarna vertelt wanneer het zou moeten stoppen. Op Android 16 verschijnt dit als Live Update-chip in de statusbalk.</item>
    </plurals>
    <!-- %1$d = hours, %2$s = start time, %3$s = end time, %4$d = percent -->
    <plurals name="al_how_rain_all_day">
        <item quantity="one">Tussen %2$s en %3$s kijkt de app ongeveer elke 15 minuten %1$d uur vooruit. Als de kans op regen %4$d%% bereikt, krijg je een seintje, hooguit eens per 3 uur.</item>
        <item quantity="other">Tussen %2$s en %3$s kijkt de app ongeveer elke 15 minuten %1$d uur vooruit. Als de kans op regen %4$d%% bereikt, krijg je een seintje, hooguit eens per 3 uur.</item>
    </plurals>
    <!-- %1$d = hours, %2$s = time, %3$d = percent -->
    <plurals name="al_how_rain_once">
        <item quantity="one">Om %2$s controleert de app het komende uur. Als de kans op regen %3$d%% bereikt, krijg je een melding met de verwachte begintijd.</item>
        <item quantity="other">Om %2$s controleert de app de komende %1$d uur. Als de kans op regen %3$d%% bereikt, krijg je een melding met de verwachte begintijd.</item>
    </plurals>
    <!-- %1$d = hours, %2$s = wind speed -->
    <plurals name="al_how_storm">
        <item quantity="one">Elke 30 minuten kijkt de app %1$d uur vooruit naar windstoten van %2$s of meer, of onweer. Hooguit één melding per 8 uur.</item>
        <item quantity="other">Elke 30 minuten kijkt de app %1$d uur vooruit naar windstoten van %2$s of meer, of onweer. Hooguit één melding per 8 uur.</item>
    </plurals>
    <string name="al_how_today">Om %1$s krijg je een kort overzicht: omstandigheden, hoogste en laagste temperatuur, wanneer regen waarschijnlijk is, opvallende wind of uv, en hoe het zich verhoudt tot gisteren.</string>
    <string name="al_how_tomorrow">Om %1$s bekijkt de app de verwachting voor morgen en stuurt een korte, leesbare samenvatting van wat je kunt verwachten en hoe het zich verhoudt tot vandaag.</string>
    <string name="al_how_wardrobe">Om %1$s (of de avond ervoor als het na 15:00 is ingesteld) bekijkt de app de uren dat je buiten bent, houdt rekening met hoe snel je het koud hebt en met je woon-werkverkeer, en stelt voor wat je aantrekt en meeneemt.</string>
    <string name="al_how_wardrobe_work">Voor 09:00–17:00 wordt de verwachting van je werklocatie gebruikt.</string>
    <!-- %1$s = time, %2$s = temperature -->
    <string name="al_how_frost">Om %1$s controleert de app de laagste temperatuur van vannacht tot morgen 10:00. Als die %2$s of lager wordt, krijg je een vorstwaarschuwing.</string>
    <!-- %1$s = time, %2$d = UV index -->
    <string name="al_how_uv">Om %1$s controleert de app de uv-verwachting van vandaag. Als die boven %2$d komt, hoor je wanneer de piek is en wanneer je je huid moet beschermen.</string>
    <!-- %1$d = hours, %2$s = temperature, %3$s = cooling level in lower case -->
    <plurals name="al_how_heat">
        <item quantity="one">Elke 30 minuten controleert de app de natteboltemperatuur nu en voor het komende uur. Als die %2$s (%3$s) bereikt, word je direct gewaarschuwd, en dezelfde dag alleen opnieuw als het erger wordt. Deze meldingen maken ook tijdens stille uren geluid.</item>
        <item quantity="other">Elke 30 minuten controleert de app de natteboltemperatuur nu en voor de komende %1$d uur. Als die %2$s (%3$s) bereikt, word je direct gewaarschuwd, en dezelfde dag alleen opnieuw als het erger wordt. Deze meldingen maken ook tijdens stille uren geluid.</item>
    </plurals>
    <!-- %1$s = time, %2$s = air quality level in lower case -->
    <string name="al_how_air">Om %1$s controleert de app de Europese luchtkwaliteitsindex voor de komende 18 uur. Als die %2$s of slechter wordt, krijg je een melding.</string>
    <!-- %1$s = time, %2$s = list of allergens -->
    <string name="al_how_pollen">Om %1$s controleert de app de pollenverwachting voor %2$s.</string>
    <string name="al_how_pollen_fallback">je allergenen</string>
    <string name="al_how_pollen_low">Bij lage gevoeligheid krijg je een melding vanaf zeer hoge niveaus.</string>
    <string name="al_how_pollen_moderate">Bij gemiddelde gevoeligheid krijg je een melding vanaf hoge niveaus.</string>
