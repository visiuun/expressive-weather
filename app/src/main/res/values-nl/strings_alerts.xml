    <!-- ============================================================ Alert types: title, one-line subtitle, long description -->
    <string name="al_type_warnings_title">Weerwaarschuwingen</string>
    <string name="al_type_warnings_subtitle">Officiële codes geel, oranje &amp; rood</string>
    <string name="al_type_warnings_desc">Krijg een melding zodra een nationale weerdienst een waarschuwing voor je locatie afgeeft, en wanneer die wordt verhoogd. Voor de VS (NWS), Canada (ECCC), Duitsland (DWD) en 36 andere Europese landen (MeteoAlarm).</string>

    <string name="al_type_nowcast_title">Regen &amp; sneeuw op komst</string>
    <string name="al_type_nowcast_subtitle">Minuten voordat regen of sneeuw begint</string>
    <string name="al_type_nowcast_desc">Een seintje kort voordat regen of sneeuw begint, met een live aftelling die wordt bijgewerkt tot het begint en je vertelt wanneer het stopt. Gebruikt de 15-minutenverwachting, die in Europa en Noord-Amerika gebaseerd is op radargegevens met hoge resolutie.</string>

    <string name="al_type_rain_title">Regenmelding</string>
    <string name="al_type_rain_subtitle">Regen verwacht in de komende uren</string>
    <string name="al_type_rain_desc">Pak een paraplu: krijg een melding als er in de komende uren waarschijnlijk regen valt. Controleer één keer op een vast tijdstip, of de hele dag tijdens de uren die je kiest.</string>

    <string name="al_type_storm_title">Wind- &amp; stormmelding</string>
    <string name="al_type_storm_subtitle">Zware windstoten of onweer op komst</string>
    <string name="al_type_storm_desc">Krijg een melding als er in de komende 12 uur windstoten boven je limiet of onweer worden verwacht, ook als er geen officiële waarschuwing is afgegeven.</string>

    <string name="al_type_today_title">Ochtendoverzicht</string>
    <string name="al_type_today_subtitle">Het weer van je dag in één oogopslag</string>
    <string name="al_type_today_desc">Elke ochtend een korte samenvatting: omstandigheden, hoogste en laagste temperatuur, wanneer het regent, wind en andere bijzonderheden, vergeleken met gisteren.</string>

    <string name="al_type_tomorrow_title">Het weer voor morgen</string>
    <string name="al_type_tomorrow_subtitle">Avondoverzicht van morgen</string>
    <string name="al_type_tomorrow_desc">Elke avond een leesbare samenvatting van morgen, zodat je vooruit kunt plannen: hoe het zich verhoudt tot vandaag, regen, wind en sneeuw.</string>

    <string name="al_type_wardrobe_title">Wat trek je aan</string>
    <string name="al_type_wardrobe_subtitle">Kledingadvies en wat je meeneemt</string>
    <string name="al_type_wardrobe_desc">Dagelijks advies over wat je aantrekt en meeneemt, afgestemd op je woon-werkverkeer, hoe snel je het koud hebt en het weer thuis en op je werk.</string>

    <string name="al_type_frost_title">Vorstmelding</string>
    <string name="al_type_frost_subtitle">Nachttemperatuur rond of onder het vriespunt</string>
    <string name="al_type_frost_desc">Krijg de avond ervoor een melding als de nachttemperatuur naar verwachting tot je drempel daalt, zodat je planten, leidingen en huisdieren kunt beschermen en tijd hebt om de auto te ontdooien.</string>

    <string name="al_type_uv_title">Uv-melding</string>
    <string name="al_type_uv_subtitle">Uv-index boven je drempel</string>
    <string name="al_type_uv_desc">Elke ochtend een herinnering om je huid te beschermen als de uv-index boven je drempel komt, met de uren waarin bescherming nodig is.</string>

    <string name="al_type_heat_title">Gevaarlijke natteboltemperatuur</string>
    <string name="al_type_heat_subtitle">Als hitte en vocht gevaarlijk worden</string>
    <string name="al_type_heat_desc">De natteboltemperatuur combineert hitte en luchtvochtigheid tot hoe goed zweet je kan afkoelen. Krijg een waarschuwing zodra die naar verwachting een gevaarlijk niveau bereikt, zodat je inspanning kunt beperken, schaduw of koele lucht kunt zoeken en genoeg kunt drinken.</string>

    <string name="al_type_air_title">Luchtkwaliteitsmelding</string>
    <string name="al_type_air_subtitle">Luchtkwaliteit op of onder je drempel</string>
    <string name="al_type_air_desc">Op je meldingstijd wordt de verwachting van de Europese luchtkwaliteitsindex gecontroleerd. Als die je drempel of slechter bereikt, krijg je een seintje om inspanning buiten te beperken.</string>

    <string name="al_type_pollen_title">Pollenmelding</string>
    <string name="al_type_pollen_subtitle">Verhoogde pollen voor je allergieën</string>
    <string name="al_type_pollen_desc">Elke ochtend wordt de pollenverwachting gecontroleerd voor de allergenen die je kiest, en krijg je een melding als de niveaus je gevoeligheid overschrijden. Pollenverwachtingen zijn beschikbaar voor Europa.</string>

    <string name="al_type_tablet_title">Herinnering hooikoortstablet</string>
    <string name="al_type_tablet_subtitle">Een dagelijkse herinnering om je tablet te nemen</string>
    <string name="al_type_tablet_desc">Een eenvoudige dagelijkse herinnering op het tijdstip dat je kiest. Optioneel alleen op dagen waarop de drempel van je pollenmelding wordt bereikt.</string>

    <string name="al_type_pressure_title">Luchtdrukdaling</string>
    <string name="al_type_pressure_subtitle">Snelle dalingen van de luchtdruk</string>
    <string name="al_type_pressure_desc">Snelle luchtdrukdalingen gaan vaak vooraf aan stormachtig weer en kunnen bij sommige mensen hoofdpijn of migraine uitlokken. Krijg een melding als de luchtdruk naar verwachting binnen 3 uur snel daalt.</string>

    <string name="al_type_friends_title">Familie &amp; vrienden</string>
    <string name="al_type_friends_subtitle">Waarschuwingen waar je dierbaren zijn</string>
    <string name="al_type_friends_desc">Krijg een melding als er een officiële waarschuwing wordt afgegeven voor de plaats van iemand in je lijst Familie &amp; vrienden.</string>

    <string name="al_type_ongoing_title">Weer in statusbalk</string>
    <string name="al_type_ongoing_subtitle">Huidige temperatuur altijd in beeld</string>
    <string name="al_type_ongoing_desc">Toont de huidige temperatuur in de statusbalk en een stille melding met de verwachting voor vandaag, op de achtergrond vernieuwd.</string>

