    <string name="d_press_falling">Dalend</string>
    <string name="d_press_falling_text">Dalende luchtdruk gaat vaak vooraf aan bewolking, regen en wind.</string>
    <string name="d_press_rising_fast">Stijgt snel</string>
    <string name="d_press_rising_fast_text">De luchtdruk stijgt snel; het weer klaart op, maar het kan flink waaien.</string>
    <string name="d_press_rising">Stijgend</string>
    <string name="d_press_rising_text">Stijgende luchtdruk betekent meestal rustiger, droger weer.</string>
    <string name="d_press_steady">Stabiel</string>
    <string name="d_press_steady_text">Geen grote verandering op basis van de luchtdruk.</string>
    <string name="d_press_headache_sharp">Kans op hoofdpijn: scherpe luchtdrukdalingen kunnen bij gevoelige mensen hoofdpijn en migraine uitlokken.</string>
    <!-- %1$d = pressure drop in hPa (5 or more) -->
    <string name="d_press_headache_fall">De luchtdruk daalt de komende dag %1$d hPa, wat sommige mensen merken als hoofdpijn of gewrichtspijn.</string>

