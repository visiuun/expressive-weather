    <string name="map_error_storms">Kan stormen niet laden</string>
    <string name="map_error_generic">Kan kaartgegevens niet laden</string>
    <string name="map_retry">Opnieuw</string>

    <!-- Map timeline labels, relative to now. %1$s is a sign character (+ or −), %2$d/%3$d are numbers.
         Keep these very short (they sit under a slider). -->
    <string name="map_now">Nu</string>
    <string name="map_rel_minutes">%1$s%2$d min</string>
    <string name="map_rel_hours">%1$s%2$du</string>
    <string name="map_rel_hours_minutes">%1$s%2$du %3$dm</string>
    <!-- Forecast hour: %1$s = day name (e.g. Today, Tue), %2$s = time of day -->
    <string name="map_day_time">%1$s %2$s</string>
    <!-- Radar timeline: %1$s = time of a nowcast (future) radar frame -->
    <string name="map_radar_forecast_time">Verwachting · %1$s</string>

    <!-- Map top panel subtitle. %1$s = relative time (e.g. Now, −30 min), %2$s = clock time. RainViewer / Open-Meteo are brand names. -->
    <string name="map_sub_radar">%1$s · %2$s · RainViewer</string>
    <string name="map_sub_radar_empty">Op dit moment geen radarbeelden beschikbaar</string>
    <!-- %1$s = relative hour (e.g. +3h), %2$s = day and time -->
    <string name="map_sub_model">%1$s · %2$s · Open-Meteo</string>
    <plurals name="map_sub_storms_active">
        <item quantity="one">%1$d actief · NOAA NHC</item>
        <item quantity="other">%1$d actief · NOAA NHC</item>
    </plurals>
    <string name="map_loading">Laden…</string>
    <string name="map_no_storms">Op dit moment geen actieve tropische stormen</string>

    <!-- Map legend under the radar layer: precipitation intensity (light rain, moderate rain, heavy rain) -->
    <string name="map_legend_radar_light">Licht</string>
    <string name="map_legend_radar_moderate">Matig</string>
    <string name="map_legend_radar_heavy">Zwaar</string>
    <!-- Map legend under the cloud cover layer: clear sky, partly cloudy, overcast -->
    <string name="map_legend_cloud_clear">Helder</string>
    <string name="map_legend_cloud_partly">Half</string>
    <string name="map_legend_cloud_overcast">Bewolkt</string>
    <!-- Map legend precipitation rate: %1$s = amount with unit (e.g. 25 mm), "per hour" -->
    <string name="map_legend_per_hour">%1$s/u</string>

