    <!-- Settings > Data & accuracy -->
    <string name="s_data_title">Gegevens</string>
    <string name="s_data_intro">Waar je verwachting vandaan komt</string>
    <string name="s_data_intro_body">Expressive Weather gebruikt gratis, open data van nationale weerdiensten. Geen account, geen API-sleutel, geen tracking: alleen de locatie die je bekijkt wordt naar de onderstaande diensten gestuurd.</string>
    <string name="s_data_group_model">Weermodel</string>
    <string name="s_data_about_models">Over modellen</string>
    <string name="s_data_about_models_body">Automatisch kiest het scherpste model voor jouw gebied — bijvoorbeeld ICON-D2 in Duitsland, AROME in Frankrijk, HRRR in de VS of Harmonie in Nederland — en vult latere dagen aan met ECMWF en GFS. Zelf een model kiezen is handig om te vergelijken; als het ergens geen gegevens voor heeft (uv, zicht, regenkans of latere dagen), vult de automatische verwachting het gat.</string>
    <string name="s_data_group_accuracy">Nauwkeurigheid</string>
    <string name="s_data_local_correction">Lokale correctie</string>
    <!-- %1$d = search radius in km -->
    <string name="s_data_local_correction_sub">Vergelijkt de verwachting met het dichtstbijzijnde weerstation op een luchthaven (METAR, binnen %1$d km) en stuurt de komende 6 uur bij richting wat er echt gemeten wordt. Privacy: alleen een ruw gebied rond je (een afgerond vak van ~70 km) wordt naar aviationweather.gov van NOAA gestuurd — nooit je exacte locatie.</string>
    <string name="s_data_show_source">Gegevensbron tonen</string>
    <string name="s_data_show_source_sub">Toon onderaan de verwachting welk model en station zijn gebruikt.</string>
    <string name="s_data_group_sources">Gegevensbronnen</string>
