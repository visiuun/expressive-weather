    <string name="widget_now_label">Teraz</string>
    <string name="widget_now_desc">Bieżące warunki. Zmniejsz do pigułki lub powiększ, by dodać prognozę godzinową.</string>
    <string name="widget_hourly_label">Godzinowa</string>
