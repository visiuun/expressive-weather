    <string name="d_seag_sail_light">Bardzo słaby wiatr — powolna żegluga, może dryf.</string>
    <string name="d_seag_sail_good">Dobry wiatr do żeglowania.</string>
    <string name="d_seag_sail_fresh">Dość silny do silnego wiatr. Refuj wcześnie; dla doświadczonych załóg.</string>
