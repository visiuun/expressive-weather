    <!-- Cooling comfort (how well sweat cools you, from wet-bulb temperature): level names and explanations -->
    <string name="d_cool_normal">Normalne</string>
    <string name="d_cool_normal_text">Za mało ciepło, by chłodzenie miało znaczenie.</string>
    <string name="d_cool_good">Dobre</string>
    <string name="d_cool_good_text">Pot łatwo paruje, a ciało dobrze się chłodzi.</string>
    <string name="d_cool_reduced">Ograniczone</string>
    <string name="d_cool_reduced_text">Pocenie chłodzi słabiej. Zwolnij podczas ćwiczeń i pij wodę.</string>
    <string name="d_cool_difficult">Trudne</string>
    <string name="d_cool_difficult_text">Chłodzenie jest trudne. Unikaj forsownego wysiłku w najgorętszej porze dnia, szukaj cienia i wentylatorów.</string>
    <string name="d_cool_very_difficult">Bardzo trudne</string>
    <string name="d_cool_very_difficult_text">U osób wrażliwych stres cieplny jest prawdopodobny nawet w spoczynku. Przebywaj w chłodnych miejscach.</string>
    <string name="d_cool_critical">Krytyczne</string>
    <string name="d_cool_critical_text">Blisko granicy możliwości chłodzenia organizmu. Zostań w klimatyzowanym miejscu i sprawdzaj, jak się mają inni.</string>

