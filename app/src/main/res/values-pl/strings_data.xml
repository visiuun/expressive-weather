    <string name="d_seag_surf_no_data">Brak danych o fali martwej.</string>
    <string name="d_seag_surf_flat">Flauta. Niewiele do pływania.</string>
    <string name="d_seag_surf_small_weak">Małe i słabe — tylko longboardy i początkujący.</string>
    <string name="d_seag_surf_small_clean">Małe, ale czyste. Dobre na longboard i do nauki.</string>
    <string name="d_seag_surf_good">Dobra, mocna fala dla średnio zaawansowanych.</string>
    <string name="d_seag_surf_decent">Przyzwoity rozmiar, ale krótki okres i mniej uporządkowana fala.</string>
    <string name="d_seag_surf_big">Duża fala — tylko dla doświadczonych.</string>
    <string name="d_seag_surf_chop">Na fali martwej leży fala wiatrowa, więc ściany będą nierówne.</string>

    <!-- Sea guidance: sailing -->
