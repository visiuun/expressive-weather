    <string name="d_usaqib_unhealthy_for_sensitive_groups">Niezdrowa dla wrażliwych</string>
    <string name="d_usaqib_unhealthy_for_sensitive_groups_text">Dzieci, seniorzy i osoby z chorobami serca lub płuc powinny ograniczyć długotrwały wysiłek.</string>
    <string name="d_usaqib_unhealthy">Niezdrowa</string>
    <string name="d_usaqib_unhealthy_text">Każdy może zacząć odczuwać skutki; osoby wrażliwe powinny unikać długotrwałego wysiłku.</string>
    <string name="d_usaqib_very_unhealthy">Bardzo niezdrowa</string>
