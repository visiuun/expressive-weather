    <string name="d_humid_comfortable_text">Przyjemnie, wilgotności nie odczujesz.</string>
    <string name="d_humid_noticeable">Wyczuwalnie wilgotno</string>
    <string name="d_humid_noticeable_text">Zaczynasz czuć wilgoć w powietrzu.</string>
    <string name="d_humid_sticky">Lepko</string>
    <string name="d_humid_sticky_text">Wilgotno; wysiłek męczy bardziej.</string>
    <string name="d_humid_muggy">Parno</string>
    <string name="d_humid_muggy_text">Ciężkie, uciążliwe powietrze dla większości osób.</string>
    <string name="d_humid_oppressive">Duszno</string>
    <string name="d_humid_oppressive_text">Bardzo niekomfortowo; nie forsuj się.</string>

    <!-- Fire weather danger levels and advice -->
