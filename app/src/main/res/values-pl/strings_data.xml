    <!-- European air quality index: levels and health advice -->
    <string name="d_euaqib_good">Dobra</string>
    <string name="d_euaqib_good_text">Jakość powietrza jest dobra. Korzystaj ze zwykłych aktywności na zewnątrz.</string>
    <string name="d_euaqib_fair">Dostateczna</string>
    <string name="d_euaqib_fair_text">Korzystaj ze zwykłych aktywności na zewnątrz.</string>
    <string name="d_euaqib_moderate">Umiarkowana</string>
    <string name="d_euaqib_moderate_text">Osoby wrażliwe z objawami powinny rozważyć ograniczenie intensywnej aktywności na zewnątrz.</string>
    <string name="d_euaqib_poor">Zła</string>
    <string name="d_euaqib_poor_text">Rozważ ograniczenie intensywnej aktywności na zewnątrz, jeśli masz objawy, takie jak pieczenie oczu, kaszel czy ból gardła.</string>
    <string name="d_euaqib_very_poor">Bardzo zła</string>
    <string name="d_euaqib_very_poor_text">Ogranicz aktywność fizyczną na zewnątrz, zwłaszcza jeśli masz objawy.</string>
    <string name="d_euaqib_extremely_poor">Skrajnie zła</string>
    <string name="d_euaqib_extremely_poor_text">Unikaj aktywności fizycznej na zewnątrz; osoby wrażliwe powinny zostać w domu.</string>

    <!-- US air quality index: levels and health advice -->
    <string name="d_usaqib_good">Dobra</string>
    <string name="d_usaqib_good_text">Jakość powietrza jest zadowalająca i nie stanowi ryzyka lub stanowi niewielkie.</string>
    <string name="d_usaqib_moderate">Umiarkowana</string>
