    <!-- Settings > Data & accuracy -->
    <string name="s_data_title">Dane</string>
    <string name="s_data_intro">Skąd pochodzi twoja prognoza</string>
    <string name="s_data_intro_body">Expressive Weather korzysta z darmowych, otwartych danych krajowych służb meteorologicznych. Bez konta, bez klucza API, bez śledzenia: do poniższych serwisów wysyłana jest tylko oglądana lokalizacja.</string>
    <string name="s_data_group_model">Model prognozy</string>
    <string name="s_data_about_models">O modelach</string>
    <string name="s_data_about_models_body">Tryb Auto wybiera najdokładniejszy model dla twojego obszaru — np. ICON-D2 w Niemczech, AROME we Francji, HRRR w USA czy Harmonie w Holandii — a dla dalszych dni dołącza ECMWF i GFS. Ręczny wybór modelu świetnie sprawdza się do porównań; gdy model nie ma danych o czymś (UV, widoczność, szansa opadów lub dalsze dni), lukę wypełnia prognoza Auto.</string>
    <string name="s_data_group_accuracy">Dokładność</string>
    <string name="s_data_local_correction">Lokalna korekta</string>
    <!-- %1$d = search radius in km -->
    <string name="s_data_local_correction_sub">Porównuje prognozę z najbliższą lotniskową stacją pogodową (METAR, w promieniu %1$d km) i koryguje najbliższe 6 godzin w stronę faktycznych pomiarów. Prywatność: do aviationweather.gov (NOAA) wysyłany jest tylko przybliżony obszar wokół ciebie (zaokrąglony kwadrat ~70 km) — nigdy dokładna lokalizacja.</string>
    <string name="s_data_show_source">Pokazuj źródło danych</string>
    <string name="s_data_show_source_sub">Pokazuj na dole prognozy, jakiego modelu i stacji użyto.</string>
