    <!-- Settings > Data & accuracy -->
    <string name="s_data_title">Dados</string>
    <string name="s_data_intro">De onde vem a sua previsão</string>
    <string name="s_data_intro_body">O Expressive Weather usa dados abertos e gratuitos de serviços meteorológicos nacionais. Sem conta, sem chave de API, sem rastreamento: só o local que você está vendo é enviado aos serviços abaixo.</string>
    <string name="s_data_group_model">Modelo de previsão</string>
    <string name="s_data_about_models">Sobre os modelos</string>
    <string name="s_data_about_models_body">O modo Automático escolhe o modelo mais preciso para a sua região — por exemplo, ICON-D2 na Alemanha, AROME na França, HRRR nos EUA ou Harmonie nos Países Baixos — e combina ECMWF e GFS para os dias seguintes. Escolher um modelo manualmente é ótimo para comparar; quando ele não tem dados para algo (UV, visibilidade, chance de chuva ou dias seguintes), a previsão Automática preenche a lacuna.</string>
    <string name="s_data_group_accuracy">Precisão</string>
    <string name="s_data_local_correction">Correção local</string>
    <!-- %1$d = search radius in km -->
    <string name="s_data_local_correction_sub">Compara a previsão com a estação meteorológica de aeroporto mais próxima (METAR, num raio de %1$d km) e ajusta as próximas 6 horas em direção ao que foi realmente medido. Privacidade: só uma área aproximada ao seu redor (um quadrado de ~70 km, arredondado) é enviada ao aviationweather.gov da NOAA — nunca a sua localização exata.</string>
    <string name="s_data_show_source">Mostrar fonte dos dados</string>
    <string name="s_data_show_source_sub">Mostra no fim da previsão qual modelo e qual estação foram usados.</string>
    <string name="s_data_group_sources">Fontes de dados</string>
