    <!-- "How it works" explanations. Times like %1$s are clock times. -->
    <string name="al_how_warnings">About every 30 minutes the app checks the national weather service for your location. You\'re notified once per warning, and again if it\'s upgraded. Amber and red warnings break through quiet hours.</string>
    <string name="al_how_warnings_saved">About every 30 minutes the app checks the national weather service for your location and your saved places. You\'re notified once per warning, and again if it\'s upgraded. Amber and red warnings break through quiet hours.</string>
    <!-- What the nowcast watches for; used as %2$s in al_how_nowcast -->
    <string name="al_how_nowcast_rain">rain</string>
    <string name="al_how_nowcast_rain_snow">rain or snow</string>
    <string name="al_how_nowcast_moderate_rain">moderate rain</string>
    <string name="al_how_nowcast_moderate_rain_snow">moderate rain or snow</string>
    <string name="al_how_nowcast_heavy_rain">heavy rain</string>
    <string name="al_how_nowcast_heavy_rain_snow">heavy rain or snow</string>
    <!-- %1$d = minutes, %2$s = what is watched (e.g. "heavy rain or snow") -->
    <plurals name="al_how_nowcast">
        <item quantity="one">Every 15 minutes the app checks the 15-minute precipitation nowcast. When %2$s is due within %1$d minute, you get a live countdown that keeps updating until it starts, then tells you when it should stop. On Android 16 it appears as a Live Update chip in the status bar.</item>
        <item quantity="other">Every 15 minutes the app checks the 15-minute precipitation nowcast. When %2$s is due within %1$d minutes, you get a live countdown that keeps updating until it starts, then tells you when it should stop. On Android 16 it appears as a Live Update chip in the status bar.</item>
    </plurals>
    <!-- %1$d = hours, %2$s = start time, %3$s = end time, %4$d = percent -->
    <plurals name="al_how_rain_all_day">
        <item quantity="one">Roughly every 15 minutes between %2$s and %3$s, the app looks %1$d hour ahead. When the chance of rain reaches %4$d%%, you\'ll get a heads-up, at most once every 3 hours.</item>
        <item quantity="other">Roughly every 15 minutes between %2$s and %3$s, the app looks %1$d hours ahead. When the chance of rain reaches %4$d%%, you\'ll get a heads-up, at most once every 3 hours.</item>
    </plurals>
    <!-- %1$d = hours, %2$s = time, %3$d = percent -->
    <plurals name="al_how_rain_once">
        <item quantity="one">At %2$s, the app checks the next hour. If the chance of rain reaches %3$d%%, you\'ll get a notification with the expected start time.</item>
        <item quantity="other">At %2$s, the app checks the next %1$d hours. If the chance of rain reaches %3$d%%, you\'ll get a notification with the expected start time.</item>
    </plurals>
    <!-- %1$d = hours, %2$s = wind speed -->
    <plurals name="al_how_storm">
        <item quantity="one">Every 30 minutes the app looks %1$d hour ahead for gusts of %2$s or more, or thunderstorms. At most one alert every 8 hours.</item>
        <item quantity="other">Every 30 minutes the app looks %1$d hours ahead for gusts of %2$s or more, or thunderstorms. At most one alert every 8 hours.</item>
    </plurals>
    <string name="al_how_today">At %1$s you get a short briefing: conditions, high and low, when rain is likely, notable wind or UV, and how it compares with yesterday.</string>
    <string name="al_how_tomorrow">At %1$s the app looks at tomorrow\'s forecast and sends a short, readable summary of what to expect and how it compares with today.</string>
    <string name="al_how_wardrobe">At %1$s (or the evening before if set after 15:00) the app looks at the hours you\'re out, adjusts for how you feel the cold and your commute, and suggests what to wear and bring.</string>
    <string name="al_how_wardrobe_work">Your work location\'s forecast is used for 09:00–17:00.</string>
    <!-- %1$s = time, %2$s = temperature -->
    <string name="al_how_frost">At %1$s the app checks tonight\'s lowest temperature until 10:00 tomorrow. If it reaches %2$s or below, you\'ll get a frost warning.</string>
    <!-- %1$s = time, %2$d = UV index -->
    <string name="al_how_uv">At %1$s the app checks today\'s UV forecast. If it will exceed %2$d, you\'ll be told the peak time and when to protect your skin.</string>
    <!-- %1$d = hours, %2$s = temperature, %3$s = cooling level in lower case -->
    <plurals name="al_how_heat">
        <item quantity="one">Every 30 minutes the app checks the wet-bulb temperature now and for the next hour. When it reaches %2$s (%3$s), you\'re warned right away, and again the same day only if it gets worse. These alerts sound even during quiet hours.</item>
        <item quantity="other">Every 30 minutes the app checks the wet-bulb temperature now and for the next %1$d hours. When it reaches %2$s (%3$s), you\'re warned right away, and again the same day only if it gets worse. These alerts sound even during quiet hours.</item>
    </plurals>
    <!-- %1$s = time, %2$s = air quality level in lower case -->
    <string name="al_how_air">At %1$s the app checks the European Air Quality Index for the next 18 hours. If it reaches %2$s or worse, you\'ll get an alert.</string>
    <!-- %1$s = time, %2$s = list of allergens -->
    <string name="al_how_pollen">At %1$s the app checks the pollen forecast for %2$s.</string>
    <string name="al_how_pollen_fallback">your allergens</string>
    <string name="al_how_pollen_low">With low sensitivity you\'re alerted from very high levels.</string>
    <string name="al_how_pollen_moderate">With moderate sensitivity you\'re alerted from high levels.</string>
    <string name="al_how_pollen_high">With high sensitivity you\'re alerted from moderate levels.</string>
    <!-- %1$s = time -->
    <string name="al_how_tablet">A daily reminder at %1$s.</string>
    <string name="al_how_tablet_pollen">A daily reminder at %1$s, only on days your pollen alert threshold is reached.</string>
    <!-- %1$d = pressure drop in hPa -->
    <string name="al_how_pressure">Every 30 minutes the app looks 12 hours ahead for a pressure fall of %1$d hPa or more within 3 hours. At most one alert every 18 hours.</string>
    <!-- %1$s = warning colour level in lower case (e.g. "amber") -->
    <string name="al_how_friends">About every 40 minutes the app checks official warnings at each Family &amp; friends place and lets you know about %1$s warnings or worse.</string>
    <string name="al_how_ongoing">A silent notification keeps the current temperature in your status bar, with today\'s high and low, rain timing and the next hours. It refreshes in the background every 15–30 minutes.</string>

