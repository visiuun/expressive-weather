    <!-- ============================================================ Alert types: title, one-line subtitle, long description -->
    <string name="al_type_warnings_title">Weather warnings</string>
    <string name="al_type_warnings_subtitle">Official yellow, amber &amp; red warnings</string>
    <string name="al_type_warnings_desc">Get notified as soon as a national weather service issues a warning for your location, and when it is upgraded. Covers the US (NWS), Canada (ECCC), Germany (DWD) and 36 more European countries (MeteoAlarm).</string>

    <string name="al_type_nowcast_title">Imminent rain &amp; snow</string>
    <string name="al_type_nowcast_subtitle">Minutes before rain or snow starts</string>
    <string name="al_type_nowcast_desc">A heads-up shortly before rain or snow arrives, with a live countdown that updates until it starts and tells you when it will stop. Uses the 15-minute nowcast, which is high-resolution radar-driven data in Europe and North America.</string>

    <string name="al_type_rain_title">Rain alert</string>
    <string name="al_type_rain_subtitle">Rain forecast in the next few hours</string>
    <string name="al_type_rain_desc">Grab an umbrella: get notified when rain is likely in the hours ahead. Check once at a set time, or all day during the hours you choose.</string>

    <string name="al_type_storm_title">Wind &amp; storm alert</string>
    <string name="al_type_storm_subtitle">Strong gusts or thunderstorms ahead</string>
    <string name="al_type_storm_desc">Get notified when gusts above your limit or thunderstorms are forecast in the next 12 hours, even when no official warning has been issued.</string>

    <string name="al_type_today_title">Morning briefing</string>
    <string name="al_type_today_subtitle">Your day\'s weather at a glance</string>
    <string name="al_type_today_desc">A short summary each morning: conditions, high and low, rain timing, wind and anything notable, compared with yesterday.</string>

    <string name="al_type_tomorrow_title">Weather for tomorrow</string>
    <string name="al_type_tomorrow_subtitle">Evening summary of tomorrow</string>
    <string name="al_type_tomorrow_desc">Each evening, a readable summary of tomorrow so you can plan ahead: how it compares with today, rain, wind and snow.</string>

    <string name="al_type_wardrobe_title">What to wear</string>
    <string name="al_type_wardrobe_subtitle">Clothing and carry-item advice</string>
    <string name="al_type_wardrobe_desc">Daily advice on what to wear and bring, tailored to your commute, how you feel the cold, and the weather at home and at work.</string>

    <string name="al_type_frost_title">Frost alert</string>
    <string name="al_type_frost_subtitle">Overnight temperatures at or below freezing</string>
    <string name="al_type_frost_desc">Get notified the evening before when the overnight temperature is forecast to drop to your threshold, so you can protect plants, pipes and pets and allow time to de-ice the car.</string>

    <string name="al_type_uv_title">UV alert</string>
    <string name="al_type_uv_subtitle">UV index above your threshold</string>
    <string name="al_type_uv_desc">Each morning, a reminder to protect your skin when the UV index will exceed your threshold, with the hours when protection is needed.</string>

    <string name="al_type_heat_title">Dangerous wet bulb</string>
    <string name="al_type_heat_subtitle">When heat and humidity get dangerous</string>
    <string name="al_type_heat_desc">The wet-bulb temperature combines heat and humidity into how well sweat can cool you. Get warned as soon as it\'s forecast to reach a dangerous level, so you can limit exertion, find shade or cool air and stay hydrated.</string>

    <string name="al_type_air_title">Air quality alert</string>
    <string name="al_type_air_subtitle">Air quality at or below your threshold</string>
    <string name="al_type_air_desc">At your alert time, checks the European Air Quality Index forecast. If it reaches your threshold or worse, you\'ll get a heads-up to limit outdoor exertion.</string>

    <string name="al_type_pollen_title">Pollen alert</string>
    <string name="al_type_pollen_subtitle">Elevated pollen for your allergies</string>
    <string name="al_type_pollen_desc">Each morning, checks the pollen forecast for the allergens you choose and lets you know when levels exceed your sensitivity. Pollen forecasts cover Europe.</string>

    <string name="al_type_tablet_title">Hay fever tablet reminder</string>
    <string name="al_type_tablet_subtitle">A daily reminder to take your tablet</string>
    <string name="al_type_tablet_desc">A simple daily reminder at the time you choose. Optionally only on days when your pollen alert threshold is reached.</string>

    <string name="al_type_pressure_title">Pressure drop alert</string>
    <string name="al_type_pressure_subtitle">Rapid falls in barometric pressure</string>
    <string name="al_type_pressure_desc">Rapid pressure drops often come before stormy weather and can trigger headaches or migraines for some people. Get notified when pressure is forecast to fall quickly over 3 hours.</string>

    <string name="al_type_friends_title">Family &amp; friends</string>
    <string name="al_type_friends_subtitle">Warnings where your people are</string>
    <string name="al_type_friends_desc">Get notified when an official warning is issued at the place of someone in your Family &amp; friends list.</string>

    <string name="al_type_ongoing_title">Status bar weather</string>
    <string name="al_type_ongoing_subtitle">Current temperature always in view</string>
    <string name="al_type_ongoing_desc">Shows the current temperature in the status bar and a silent notification with today\'s forecast, refreshed in the background.</string>

