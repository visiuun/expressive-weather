    <string name="d_press_dropping_fast_text">Pressure is falling quickly — a sign of an approaching storm or strong wind.</string>
    <string name="d_press_falling">Falling</string>
    <string name="d_press_falling_text">Falling pressure often comes before clouds, rain and wind.</string>
    <string name="d_press_rising_fast">Rising fast</string>
    <string name="d_press_rising_fast_text">Pressure is climbing quickly; weather is clearing, but it can be breezy.</string>
    <string name="d_press_rising">Rising</string>
    <string name="d_press_rising_text">Rising pressure usually means settling, drier weather.</string>
    <string name="d_press_steady">Steady</string>
    <string name="d_press_steady_text">No big change from pressure alone.</string>
    <string name="d_press_headache_sharp">Headache risk: sharp pressure drops can trigger headaches and migraines in sensitive people.</string>
    <!-- %1$d = pressure drop in hPa (5 or more) -->
    <string name="d_press_headache_fall">Pressure will fall %1$d hPa over the next day, which some people feel as headaches or joint pain.</string>

