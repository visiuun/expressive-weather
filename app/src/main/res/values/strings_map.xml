<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Map screen: weather layer names. *_title is the full name shown in the panel header and as
         accessibility label; *_short is the compact label on the selected layer button in the bottom toolbar. -->
    <string name="map_layer_none_title">Map</string>
    <string name="map_layer_none_short">Map</string>
    <string name="map_layer_radar_title">Radar</string>
    <string name="map_layer_radar_short">Radar</string>
    <string name="map_layer_temperature_title">Temperature</string>
    <string name="map_layer_temperature_short">Temp</string>
    <string name="map_layer_wind_title">Wind</string>
    <string name="map_layer_wind_short">Wind</string>
    <string name="map_layer_clouds_title">Cloud cover</string>
    <string name="map_layer_clouds_short">Clouds</string>
    <string name="map_layer_pressure_title">Pressure</string>
    <string name="map_layer_pressure_short">Pressure</string>
    <string name="map_layer_precipitation_title">Precipitation</string>
    <string name="map_layer_precipitation_short">Rain</string>
    <string name="map_layer_storms_title">Tropical storms</string>
    <string name="map_layer_storms_short">Storms</string>

    <!-- Map screen: error pill shown when a layer fails to download, with a Retry button. -->
    <string name="map_error_radar">Couldn\'t load radar</string>
    <string name="map_error_forecast">Couldn\'t load forecast map</string>
    <string name="map_error_storms">Couldn\'t load storms</string>
    <string name="map_error_generic">Couldn\'t load map data</string>
    <string name="map_retry">Retry</string>

    <!-- Map timeline labels, relative to now. %1$s is a sign character (+ or −), %2$d/%3$d are numbers.
         Keep these very short (they sit under a slider). -->
    <string name="map_now">Now</string>
    <string name="map_rel_minutes">%1$s%2$d min</string>
    <string name="map_rel_hours">%1$s%2$dh</string>
    <string name="map_rel_hours_minutes">%1$s%2$dh %3$dm</string>
    <!-- Forecast hour: %1$s = day name (e.g. Today, Tue), %2$s = time of day -->
    <string name="map_day_time">%1$s %2$s</string>
    <!-- Radar timeline: %1$s = time of a nowcast (future) radar frame -->
    <string name="map_radar_forecast_time">Forecast · %1$s</string>

    <!-- Map top panel subtitle. %1$s = relative time (e.g. Now, −30 min), %2$s = clock time. RainViewer / Open-Meteo are brand names. -->
    <string name="map_sub_radar">%1$s · %2$s · RainViewer</string>
    <string name="map_sub_radar_empty">No radar frames available right now</string>
    <!-- %1$s = relative hour (e.g. +3h), %2$s = day and time -->
    <string name="map_sub_model">%1$s · %2$s · Open-Meteo</string>
    <plurals name="map_sub_storms_active">
        <item quantity="one">%1$d active · NOAA NHC</item>
        <item quantity="other">%1$d active · NOAA NHC</item>
    </plurals>
    <string name="map_loading">Loading…</string>
    <string name="map_no_storms">No active tropical storms right now</string>

    <!-- Map legend under the radar layer: precipitation intensity (light rain, moderate rain, heavy rain) -->
    <string name="map_legend_radar_light">Light</string>
    <string name="map_legend_radar_moderate">Moderate</string>
    <string name="map_legend_radar_heavy">Heavy</string>
    <!-- Map legend under the cloud cover layer: clear sky, partly cloudy, overcast -->
    <string name="map_legend_cloud_clear">Clear</string>
    <string name="map_legend_cloud_partly">Partly</string>
    <string name="map_legend_cloud_overcast">Overcast</string>
    <!-- Map legend precipitation rate: %1$s = amount with unit (e.g. 25 mm), "per hour" -->
    <string name="map_legend_per_hour">%1$s/h</string>

    <!-- Map controls (accessibility labels) -->
    <string name="map_cd_sources">Map data sources</string>
    <string name="map_cd_recenter">Centre on my place</string>
    <string name="map_cd_play">Play</string>
    <string name="map_cd_pause">Pause</string>
    <string name="map_cd_back_to_now">Back to now</string>

    <!-- Map data sources sheet. Service and licence names (OpenStreetMap, CARTO, ODbL, CC BY 4.0...) stay untranslated. -->
    <string name="map_sources_title">Map data</string>
    <string name="map_sources_body">Tiles and weather data are fetched directly from these services. No account, no API key, and nothing about you is sent beyond the map area you\'re looking at.</string>
    <!-- %1$s = what the service provides, %2$s = its licence -->
    <string name="map_source_line">%1$s · %2$s</string>
    <string name="map_source_osm_what">Map data and standard map tiles</string>
    <!-- Positron and Dark Matter are CARTO product names -->
    <string name="map_source_carto_what">Positron &amp; Dark Matter basemaps</string>
    <string name="map_source_rainviewer_what">Radar imagery</string>
    <string name="map_source_rainviewer_license">Free RainViewer API</string>
    <string name="map_source_openmeteo_what">Temperature, wind, cloud, pressure &amp; precipitation</string>
    <string name="map_source_nhc_what">Tropical storms</string>
    <string name="map_source_nhc_license">U.S. public domain</string>

    <!-- Tropical cyclone classifications (NOAA National Hurricane Center) -->
    <string name="map_storm_td">Tropical depression</string>
    <string name="map_storm_std">Subtropical depression</string>
    <string name="map_storm_ts">Tropical storm</string>
    <string name="map_storm_sts">Subtropical storm</string>
    <string name="map_storm_hu">Hurricane</string>
    <!-- %1$d = Saffir–Simpson category 1–5 -->
    <string name="map_storm_hu_cat">Hurricane · Category %1$d</string>
    <string name="map_storm_ty">Typhoon</string>
    <!-- %1$d = Saffir–Simpson category 1–5 -->
    <string name="map_storm_ty_cat">Typhoon · Category %1$d</string>
    <string name="map_storm_ptc">Post-tropical cyclone</string>
    <string name="map_storm_pc">Potential tropical cyclone</string>
    <string name="map_storm_generic">Tropical cyclone</string>
    <!-- Fallback name for a storm the NHC has not named -->
    <string name="map_storm_unnamed">Unnamed</string>

    <!-- Storm marker on the map. Label: %1$s = storm name, %2$s = short category (e.g. Cat 3) or classification code -->
    <string name="map_storm_marker">%1$s · %2$s</string>
    <!-- Short Saffir–Simpson category on the storm marker, %1$d = 1–5 -->
    <string name="map_storm_cat_short">Cat %1$d</string>
    <!-- Accessibility label of a storm marker: %1$s = classification (e.g. Hurricane · Category 3), %2$s = storm name -->
    <string name="map_storm_cd">%1$s %2$s</string>

    <!-- Storm details sheet -->
    <string name="map_storm_wind">Sustained wind</string>
    <string name="map_storm_pressure">Pressure</string>
    <string name="map_storm_moving">Moving</string>
    <string name="map_storm_stationary">Stationary or unknown</string>
    <!-- %1$s = compass direction (e.g. NW), %2$s = speed with unit -->
    <string name="map_storm_moving_value">%1$s at %2$s</string>
    <string name="map_storm_position">Position</string>
    <string name="map_storm_updated">Updated</string>
    <string name="map_storm_advisory">Read the NHC advisory</string>
    <!-- Hemisphere letters in coordinates (e.g. 23.4°N, 71.2°W) -->
    <string name="map_hemi_north">N</string>
    <string name="map_hemi_south">S</string>
    <string name="map_hemi_east">E</string>
    <string name="map_hemi_west">W</string>

</resources>
