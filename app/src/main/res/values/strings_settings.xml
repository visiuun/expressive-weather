    <!-- Settings > Data & accuracy -->
    <string name="s_data_title">Data</string>
    <string name="s_data_intro">Where your forecast comes from</string>
    <string name="s_data_intro_body">Expressive Weather uses free, open data from national weather services. No account, no API key, no tracking: only the location you\'re viewing is sent to the services below.</string>
    <string name="s_data_group_model">Forecast model</string>
    <string name="s_data_about_models">About models</string>
    <string name="s_data_about_models_body">Auto picks the sharpest model for your area — for example ICON-D2 in Germany, AROME in France, HRRR in the US or Harmonie in the Netherlands — and blends in ECMWF and GFS for later days. Picking a model yourself is great for comparing; when it has no data for something (UV, visibility, rain chance or later days), the Auto forecast fills the gap.</string>
    <string name="s_data_group_accuracy">Accuracy</string>
    <string name="s_data_local_correction">Local correction</string>
    <!-- %1$d = search radius in km -->
    <string name="s_data_local_correction_sub">Compares the forecast with the nearest airport weather station (METAR, within %1$d km) and nudges the next 6 hours toward what\'s actually measured. Privacy: only a rough area around you (a ~70 km box, rounded) is sent to NOAA\'s aviationweather.gov — never your exact location.</string>
    <string name="s_data_show_source">Show data source</string>
    <string name="s_data_show_source_sub">Show which model and station were used at the bottom of the forecast.</string>
    <string name="s_data_group_sources">Data sources</string>
    <!-- Data sources list: what each provider is used for, and its licence -->
    <string name="s_src_openmeteo_use">Forecasts, air quality (Copernicus CAMS), marine and place search</string>
    <string name="s_src_national">National weather services</string>
    <string name="s_src_national_use">Models used by Auto: DWD, NOAA, ECMWF, Météo-France, Met Office, KNMI, DMI, MET Norway, MeteoSwiss, ECCC, JMA and more</string>
    <string name="s_src_national_licence">Open data, mostly CC BY 4.0</string>
